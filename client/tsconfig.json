{
    "compilerOptions": {
      "target": "es2016",
      "module": "commonjs",
      "declaration": true,
      "outDir": "./dist",
      "allowJs": true,
      "strict": true,
      "noImplicitAny": false,
      "esModuleInterop": true,
      "preserveConstEnums": true,
      "moduleResolution": "Node",
      "allowSyntheticDefaultImports": true,
      "downlevelIteration": true,
      "skipLibCheck": true
    },
  "include": [
    "./accounts/",
    "./errors/",
    "./instructions/",
    "./queries/",
    "./types/",
    "./index.ts",
    "./programId.ts"
  ]
  }
